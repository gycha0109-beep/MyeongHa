{
  "name": "myeongha",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "node scripts/build-web-static.mjs",
    "verify:deployment-config": "node scripts/verify-web-deployment.mjs",
    "verify:supabase-deployment-config": "node scripts/verify-supabase-deployment.mjs",
    "verify:production-user-data-bindings": "node scripts/verify-production-user-data-bindings.mjs",
    "verify:production-guest-bootstrap-ttl-binding": "node scripts/verify-production-guest-bootstrap-ttl-binding.mjs",
    "verify:production-member-me-smoke-workflow": "node scripts/verify-production-member-me-smoke-workflow.mjs",
    "verify:production:api": "node scripts/verify-production-api.mjs",
    "verify:production:member-me": "node scripts/verify-production-member-me.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:web && npm run verify:deployment-config && npm run verify:supabase-deployment-config && npm run verify:production-user-data-bindings && npm run verify:production-guest-bootstrap-ttl-binding && npm run verify:production-member-me-smoke-workflow"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
