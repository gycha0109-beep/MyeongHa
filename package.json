{
  "name": "myeongha",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "node scripts/build-web-static.mjs",
    "verify:deploy": "node scripts/verify-web-deployment.mjs",
    "verify:deploy:supabase": "node scripts/verify-supabase-deployment.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:web && npm run verify:deploy && npm run verify:deploy:supabase"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  }
}
