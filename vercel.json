{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "cleanUrls": false,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "functions": {
    "api/health.ts": {
      "supportsCancellation": true
    },
    "api/readiness.ts": {
      "supportsCancellation": true
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/readiness).*)",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": {
            "pre": "myeongha-",
            "suf": "-johnny-self.vercel.app"
          }
        }
      ],
      "destination": "https://myeongha.vercel.app/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/social/naver/authorize",
      "destination": "/api/auth/sign-in?__myeongha_naver_oauth_bridge=authorize"
    },
    {
      "source": "/api/auth/social/naver/callback",
      "destination": "/api/auth/sign-in?__myeongha_naver_oauth_bridge=callback"
    },
    {
      "source": "/api/auth/social/naver/token",
      "destination": "/api/auth/sign-in?__myeongha_naver_oauth_bridge=token"
    },
    {
      "source": "/api/auth/social/naver/userinfo",
      "destination": "/api/auth/sign-in?__myeongha_naver_oauth_bridge=userinfo"
    },
    {
      "source": "/api/auth/social/start",
      "destination": "/api/auth/sign-in?__myeongha_social_auth_start=1"
    },
    {
      "source": "/api/me/saju/preview-reading",
      "destination": "/api/me?__myeongha_saju_preview_reading=1"
    },
    {
      "source": "/api/chat",
      "destination": "/api/me?__myeongha_chat_open=1"
    },
    {
      "source": "/api/chat/:threadId/turns",
      "destination": "/api/me?__myeongha_chat_turn_send=1&__myeongha_chat_thread_id=:threadId"
    },
    {
      "source": "/api/chat/:threadId",
      "destination": "/api/me?__myeongha_chat_thread_id=:threadId"
    },
    {
      "source": "/api/life-record",
      "destination": "/api/me?__myeongha_records_read=life-record"
    },
    {
      "source": "/api/readings",
      "destination": "/api/me?__myeongha_records_read=readings"
    },
    {
      "source": "/api/memories",
      "destination": "/api/me?__myeongha_records_read=memories"
    },
    {
      "source": "/api/birth-profiles/:id",
      "destination": "/api/birth-profiles?__myeongha_birth_profile_id=:id"
    },
    {
      "source": "/api/device-installations/register",
      "destination": "/api/me?__myeongha_device_installation_action=register"
    },
    {
      "source": "/api/device-installations/:id/revoke",
      "destination": "/api/me?__myeongha_device_installation_action=revoke&__myeongha_device_installation_id=:id"
    },
    {
      "source": "/api/target-persons",
      "destination": "/api/me?__myeongha_target_person_read=list"
    },
    {
      "source": "/api/target-persons/:id",
      "destination": "/api/me?__myeongha_target_person_read=detail&__myeongha_target_person_id=:id"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
