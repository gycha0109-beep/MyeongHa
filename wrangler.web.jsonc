{
  "name": "myeongha-web",
  "main": "./cloudflare/web-worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "services": [
    { "binding": "AUTHORITY_API", "service": "myeongha" }
  ]
}
