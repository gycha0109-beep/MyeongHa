  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist"
  },
  "include": [
    "api/**/*.ts",
    "apps/**/src/**/*.ts",
    "packages/**/src/**/*.ts"
  ],
  "exclude": [
    "test/**",
    "**/*.test.ts"
  ]
}
