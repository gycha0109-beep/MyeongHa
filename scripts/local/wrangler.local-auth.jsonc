{
  "name": "myeongha-local-auth",
  "main": "../../cloudflare/myeongha-worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "vars": {
    "MYEONGHA_LOCAL_AUTH_MODE": "isolated-v1"
  },
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "987654",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
