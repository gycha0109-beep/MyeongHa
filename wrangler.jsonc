{
  "name": "myeongha",
  "main": "./cloudflare/myeongha-worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "previews": {},
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "25691",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
