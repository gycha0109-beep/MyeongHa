{
  "name": "myeongha",
  "main": "./cloudflare/myeongha-worker.mjs",
  "hyperdrive": [
    {"binding":"HYPERDRIVE","id":"1ffe61390c064c0480a0a1e933e4d2c9"},
    {"binding":"SEYEON_SUBJECT_HYPERDRIVE","id":"8ee320f55db94f66b2681fcc43995219"},
    {"binding":"SEYEON_GOVERNED_HYPERDRIVE","id":"64e88db2afcd4118afe1fe29bdf31742"}
  ],
  "vars": {
    "MYEONGHA_CLOUDFLARE_POSTGRES_TRANSPORT":"approved-supabase-hyperdrive-v1",
    "MYEONGHA_CLOUDFLARE_HYPERDRIVE_ORIGIN_POLICY":"supabase-verify-full-rls-v1",
    "MYEONGHA_CLOUDFLARE_HYPERDRIVE_PRINCIPAL":"myeongha_cf_hyperdrive_login"
  },
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "previews": {},
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "25691",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
