{
  "name": "myeongha",
  "main": "./cloudflare/myeongha-worker.mjs",
  "alias": {
    "pg-cloudflare": "./cloudflare/postgres-native-socket.mjs"
  },
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "previews": {},
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "25691",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
