{
  "name": "myeongha",
  "main": "./cloudflare/myeongha-worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "previews": {},
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
