{
  "name": "myeongha",
  "main": "./cloudflare/myeongha-worker.mjs",
  "alias": {
    "pg-cloudflare": "./cloudflare/postgres-native-socket.mjs"
  },
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "previews": {}
}
