{
  "expo": {
    "name": "명하",
    "slug": "myeongha-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "myeongha",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "관상에 사용할 사진을 선택할 수 있도록 사진 접근을 허용해 주세요.",
          "cameraPermission": "관상 사진을 촬영할 수 있도록 카메라 접근을 허용해 주세요.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
