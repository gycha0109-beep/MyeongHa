{
  "expo": {
    "name": "명하",
    "slug": "myeongha-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "myeongha",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiOrigin": "https://myeongha.vercel.app"
    }
  }
}
