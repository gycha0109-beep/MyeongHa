# Only the image build may contact public package/source registries.
# Runtime execution must use --network none, readonly source, no secrets.
# Pinned Docker Official Python multi-platform index (verified linux/amd64 Python 3.14.10 slim-trixie).
FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f
COPY requirements.lock /tmp/myeongha-gepa-requirements.lock
COPY build-requirements-hashed.lock /tmp/myeongha-gepa-build-requirements.lock
RUN set -eu; \
    apt-get update; \
    apt-get install --no-install-recommends -y git ca-certificates; \
    python -m pip --isolated install --disable-pip-version-check --no-cache-dir \
      --no-deps --only-binary=:all: --require-hashes \
      -r /tmp/myeongha-gepa-build-requirements.lock; \
    python -m pip --isolated install --disable-pip-version-check --no-cache-dir \
      --no-deps --no-build-isolation --check-build-dependencies \
      -r /tmp/myeongha-gepa-requirements.lock; \
    apt-get purge --auto-remove -y git; \
    rm -rf /var/lib/apt/lists/* /tmp/myeongha-gepa-requirements.lock /tmp/myeongha-gepa-build-requirements.lock
